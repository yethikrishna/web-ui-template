---
/**
 * Features — Responsive grid of feature cards.
 *
 * Each card displays an optional icon glyph, a title, and a description.
 * The grid is fluid (auto-fit, minmax) so it adapts from one to many columns.
 *
 * Props:
 *   kicker?: string
 *   title?: string
 *   items: Array<{ title: string; description: string; icon?: string }>
 */
interface FeatureItem {
  title: string;
  description: string;
  icon?: string;
}

interface Props {
  items: FeatureItem[];
  title?: string;
  kicker?: string;
}

const { items, title, kicker } = Astro.props;

const headingId = title ? 'features-title' : undefined;
---

<section class="features" aria-labelledby={headingId}>
  <div class="features__inner">
    {(kicker || title) && (
      <header class="features__head">
        {kicker && <p class="features__kicker">{kicker}</p>}
        {title && <h2 class="features__title" id={headingId}>{title}</h2>}
      </header>
    )}

    <ul class="features__grid" role="list">
      {items.map((item) => (
        <li class="feature-card">
          {item.icon && (
            <span class="feature-card__icon" aria-hidden="true">{item.icon}</span>
          )}
          <div class="feature-card__body">
            <h3 class="feature-card__title">{item.title}</h3>
            <p class="feature-card__desc">{item.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .features {
    padding: 4rem 1.5rem;
  }

  .features__inner {
    max-width: var(--max);
    margin-inline: auto;
  }

  .features__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .features__kicker {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .features__title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .features__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .feature-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .feature-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .feature-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .feature-card__title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .feature-card__desc {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .features {
      padding: 3rem 1.25rem;
    }
  }
</style>
