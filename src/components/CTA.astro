---
/**
 * CTA — Call-to-action band.
 *
 * Renders a centered, contained call-to-action with an optional kicker,
 * title, description, and up to two action buttons. Visually elevated via
 * the design-system elevated background and border tokens.
 *
 * Props:
 *   kicker?: string
 *   title: string        - headline (required)
 *   description?: string - supporting copy
 *   primaryCta?: Cta     - primary action button { text, href }
 *   secondaryCta?: Cta   - secondary action button { text, href }
 */
interface Cta {
  text: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  kicker?: string;
}

const { title, description, primaryCta, secondaryCta, kicker } = Astro.props;

const hasActions = Boolean(primaryCta || secondaryCta);
---

<section class="cta" aria-labelledby="cta-title">
  <div class="cta__inner">
    {kicker && <p class="cta__kicker">{kicker}</p>}
    <h2 class="cta__title" id="cta-title">{title}</h2>
    {description && <p class="cta__desc">{description}</p>}
    {hasActions && (
      <div class="cta__actions">
        {primaryCta && (
          <a class="btn btn--primary" href={primaryCta.href}>{primaryCta.text}</a>
        )}
        {secondaryCta && (
          <a class="btn btn--secondary" href={secondaryCta.href}>{secondaryCta.text}</a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .cta {
    padding: 4rem 1.5rem;
  }

  .cta__inner {
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 3rem 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
  }

  .cta__kicker {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .cta__title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .cta__desc {
    margin: 0;
    max-width: 52ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.6rem;
    padding: 0 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    font-family: var(--mono);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.12s ease, color 0.12s ease, background 0.12s ease;
  }

  .btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .btn--primary:hover {
    background: color-mix(in srgb, var(--accent) 86%, var(--ink));
    border-color: color-mix(in srgb, var(--accent) 86%, var(--ink));
  }

  .btn--secondary {
    background: transparent;
    color: var(--ink-soft);
  }

  .btn--secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .cta__inner {
      padding: 2.25rem 1.25rem;
    }
    .cta__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .btn {
      width: 100%;
    }
  }
</style>
