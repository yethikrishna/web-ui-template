---
const name = 'Yethikrishna R';
const role = 'Founder, myndlabs';
const photo = '/assets/author-yethikrishna.png';
const instagram = 'https://instagram.com/yethikrishnar';
const email = 'hey@myndlabs.tech';
---

<aside class="author-card" aria-label="About the author">
  <img class="author-photo" src={photo} width="72" height="72" alt={name} loading="lazy" decoding="async" />
  <div class="author-body">
    <p class="author-name">{name}</p>
    <p class="author-role">{role}</p>
    <div class="author-links">
      <a href={instagram} target="_blank" rel="me noopener" aria-label={`${name} on Instagram`}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/>
        </svg>
        <span>Instagram</span>
      </a>
      <a href={`mailto:${email}`} aria-label={`Email ${name}`}>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
          <path d="m3 6 9 7 9-7" />
        </svg>
        <span>Email</span>
      </a>
    </div>
  </div>
</aside>
