---
/**
 * Testimonials — Grid of testimonial cards.
 *
 * Each card renders a quote, the author's name, an optional role, and an
 * optional avatar image. Avatars use width/height attributes to prevent
 * layout shift and an empty alt when purely decorative (the author name is
 * already conveyed in text).
 *
 * Props:
 *   kicker?: string
 *   title?: string
 *   testimonials: Array<{
 *     quote: string;
 *     author: string;
 *     role?: string;
 *     avatar?: string;
 *   }>
 */
interface Testimonial {
  quote: string;
  author: string;
  role?: string;
  avatar?: string;
}

interface Props {
  testimonials: Testimonial[];
  title?: string;
  kicker?: string;
}

const { testimonials, title, kicker } = Astro.props;

const headingId = title ? 'testimonials-title' : undefined;
---

<section class="testimonials" aria-labelledby={headingId}>
  <div class="testimonials__inner">
    {(kicker || title) && (
      <header class="testimonials__head">
        {kicker && <p class="testimonials__kicker">{kicker}</p>}
        {title && <h2 class="testimonials__title" id={headingId}>{title}</h2>}
      </header>
    )}

    <ul class="testimonials__grid" role="list">
      {testimonials.map((t) => (
        <li>
          <figure class="testimonial">
            <blockquote class="testimonial__quote">
              <p>&ldquo;{t.quote}&rdquo;</p>
            </blockquote>
            <figcaption class="testimonial__author">
              {t.avatar && (
                <img
                  class="testimonial__avatar"
                  src={t.avatar}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                />
              )}
              <span class="testimonial__meta">
                <span class="testimonial__name">{t.author}</span>
                {t.role && <span class="testimonial__role">{t.role}</span>}
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .testimonials {
    padding: 4rem 1.5rem;
  }

  .testimonials__inner {
    max-width: var(--max);
    margin-inline: auto;
  }

  .testimonials__head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .testimonials__kicker {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .testimonials__title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .testimonials__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .testimonial {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    height: 100%;
  }

  .testimonial__quote {
    margin: 0;
    flex: 1;
  }

  .testimonial__quote p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .testimonial__author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .testimonial__avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    flex-shrink: 0;
  }

  .testimonial__meta {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .testimonial__name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }

  .testimonial__role {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .testimonials {
      padding: 3rem 1.25rem;
    }
  }
</style>
