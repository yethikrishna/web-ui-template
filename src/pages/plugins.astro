---
import MarketingLayout from '../components/MarketingLayout.astro';
---

<MarketingLayout
  title="Showcase — sites built with varsha"
  description="Explore sites and templates built with the varsha premium website starter. From landing pages to docs, blogs, portfolios, and SaaS products."
  canonicalPath="/plugins/"
>
  <main class="showcase-page">
    <section class="section showcase-hero">
      <p class="section-kicker"># showcase</p>
      <h2>Sites built with varsha.</h2>
      <p class="showcase-lede">
        A curated selection of websites, templates, and starter kits powered by varsha.
        From landing pages to full documentation sites — see what the starter can do.
      </p>
      <p class="showcase-cta-row">
        <a class="button button-primary" href="https://github.com/yethikrishna/web-ui-template">View on GitHub</a>
        <a class="button button-secondary" href="/docs/install/">Get started</a>
      </p>
    </section>

    <section class="section showcase-featured">
      <div class="section-heading">
        <p class="section-kicker">Featured</p>
        <h3>Founder by myndlabs</h3>
      </div>
      <a class="showcase-featured-card" href="https://founder.myndlabs.tech" target="_blank" rel="noopener noreferrer">
        <div class="showcase-featured-preview" aria-hidden="true">
          <div class="showcase-browser-chrome">
            <span class="showcase-dot showcase-dot-r"></span>
            <span class="showcase-dot showcase-dot-y"></span>
            <span class="showcase-dot showcase-dot-g"></span>
            <span class="showcase-url-bar">founder.myndlabs.tech</span>
          </div>
          <div class="showcase-featured-body">
            <div class="showcase-f-hero">
              <span class="showcase-f-badge">founder</span>
              <h4>Build your founder presence in minutes.</h4>
              <p>A complete personal site template — writing, links, newsletter, and analytics.</p>
            </div>
            <div class="showcase-f-grid">
              <div class="showcase-f-block"></div>
              <div class="showcase-f-block"></div>
              <div class="showcase-f-block"></div>
            </div>
          </div>
        </div>
        <div class="showcase-featured-meta">
          <div>
            <strong>founder.myndlabs.tech</strong>
            <span>Personal founder site with blog, links, and newsletter.</span>
          </div>
          <span class="showcase-go">visit site →</span>
        </div>
      </a>
    </section>

    <section class="section showcase-categories">
      <div class="section-heading">
        <p class="section-kicker">Template categories</p>
        <h3>Start from a proven pattern.</h3>
        <p>Every template ships with the full varsha design system, docs, blog, and palette switcher pre-configured.</p>
      </div>
      <div class="showcase-grid">
        <article class="showcase-card">
          <div class="showcase-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12 12 3l9 9"/><path d="M5 10v10h14V10"/>
            </svg>
          </div>
          <h4>Landing</h4>
          <p>High-converting marketing pages with hero, features, pricing, and CTA sections.</p>
          <span class="showcase-card-tag">marketing</span>
        </article>

        <article class="showcase-card">
          <div class="showcase-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/>
            </svg>
          </div>
          <h4>Docs</h4>
          <p>Starlight-powered documentation with search, sidebar navigation, and i18n.</p>
          <span class="showcase-card-tag">starlight</span>
        </article>

        <article class="showcase-card">
          <div class="showcase-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16v12H5l-1 4z"/><path d="M8 9h8M8 12h5"/>
            </svg>
          </div>
          <h4>Blog</h4>
          <p>MDX-powered blog with content collections, tags, RSS feeds, and author cards.</p>
          <span class="showcase-card-tag">mdx</span>
        </article>

        <article class="showcase-card">
          <div class="showcase-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
            </svg>
          </div>
          <h4>Portfolio</h4>
          <p>Showcase your work with project galleries, case studies, and contact forms.</p>
          <span class="showcase-card-tag">personal</span>
        </article>

        <article class="showcase-card">
          <div class="showcase-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 3h18v6H3z"/><path d="M7 9v12h10V9"/><path d="M10 13h4"/>
            </svg>
          </div>
          <h4>SaaS</h4>
          <p>Complete SaaS marketing sites with pricing tables, feature comparisons, and changelogs.</p>
          <span class="showcase-card-tag">product</span>
        </article>

        <article class="showcase-card showcase-card-cta">
          <div class="showcase-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </div>
          <h4>Your site here</h4>
          <p>Built something with varsha? Share it with the community and get featured.</p>
          <a class="showcase-card-link" href="https://github.com/yethikrishna/web-ui-template/issues/new/choose">Submit your site →</a>
        </article>
      </div>
    </section>

    <section class="section showcase-submit">
      <div class="showcase-submit-card">
        <p class="section-kicker"># open source</p>
        <h3>varsha is free and open source.</h3>
        <p>
          Clone the repository, customize it to your brand, and deploy. Star the repo to
          support the project and stay updated with new templates and features.
        </p>
        <div class="showcase-submit-actions">
          <a class="button button-primary" href="https://github.com/yethikrishna/web-ui-template">★ Star on GitHub</a>
          <a class="button button-secondary" href="mailto:hey@myndlabs.tech">Get in touch</a>
        </div>
      </div>
    </section>
  </main>

  <style is:global>
    .showcase-page {
      padding-bottom: 5rem;
    }

    .showcase-page .section {
      padding-block: 0;
      border-top: none;
    }

    .showcase-hero {
      padding-top: 3rem;
    }

    .showcase-hero h2 {
      margin: 0;
      color: var(--ink);
      font-family: var(--mono);
      font-weight: 400;
      letter-spacing: -0.04em;
      line-height: 1.05;
      font-size: clamp(2rem, 4vw, 3rem);
    }

    .showcase-lede {
      max-width: 640px;
      margin: 1.1rem 0 0;
      color: var(--ink-soft);
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      line-height: 1.6;
    }

    .showcase-cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin: 1.5rem 0 0;
    }

    /* Featured */
    .showcase-featured {
      margin-top: 3.5rem;
    }

    .showcase-featured h3 {
      margin: 0.25rem 0 1rem;
      color: var(--ink);
      font-family: var(--mono);
      font-weight: 400;
      font-size: 1.4rem;
      letter-spacing: -0.02em;
    }

    .showcase-featured-card {
      display: block;
      text-decoration: none;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--bg-elevated);
      overflow: hidden;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }

    a.showcase-featured-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .showcase-featured-preview {
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding: 1rem 1rem 0;
    }

    .showcase-browser-chrome {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 0.75rem;
      background: var(--bg-elevated);
      border: 1px solid var(--line);
      border-bottom: none;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }

    .showcase-dot {
      width: 0.7rem;
      height: 0.7rem;
      border-radius: 50%;
    }
    .showcase-dot-r { background: #ff5f57; }
    .showcase-dot-y { background: #febc2e; }
    .showcase-dot-g { background: #28c840; }

    .showcase-url-bar {
      margin-left: 0.75rem;
      padding: 0.25rem 0.75rem;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--muted);
      flex: 1;
      text-align: center;
    }

    .showcase-featured-body {
      padding: 2rem 1.5rem;
      background: linear-gradient(135deg, var(--bg-elevated), color-mix(in srgb, var(--accent) 6%, var(--bg-elevated)));
      min-height: 180px;
    }

    .showcase-f-hero {
      max-width: 480px;
    }

    .showcase-f-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      background: var(--accent);
      color: var(--bg);
      border-radius: var(--radius-sm);
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .showcase-f-hero h4 {
      margin: 0.8rem 0 0.5rem;
      color: var(--ink);
      font-family: var(--mono);
      font-weight: 400;
      font-size: clamp(1.3rem, 2.5vw, 1.75rem);
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .showcase-f-hero p {
      margin: 0;
      color: var(--ink-soft);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .showcase-f-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .showcase-f-block {
      height: 3rem;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
    }

    .showcase-featured-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.25rem;
    }

    .showcase-featured-meta strong {
      display: block;
      color: var(--ink);
      font-family: var(--mono);
      font-size: 0.95rem;
      font-weight: 600;
    }

    .showcase-featured-meta span {
      display: block;
      margin-top: 0.2rem;
      color: var(--muted);
      font-size: 0.85rem;
    }

    .showcase-go {
      color: var(--accent);
      font-family: var(--mono);
      font-size: 0.82rem;
      flex-shrink: 0;
    }

    a.showcase-featured-card:hover .showcase-go {
      text-decoration: underline;
    }

    /* Categories */
    .showcase-categories {
      margin-top: 3.5rem;
    }

    .showcase-categories h3 {
      margin: 0.25rem 0 0.5rem;
      color: var(--ink);
      font-family: var(--mono);
      font-weight: 400;
      font-size: 1.4rem;
      letter-spacing: -0.02em;
    }

    .showcase-categories .section-heading p:last-child {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
      max-width: 60ch;
    }

    .showcase-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
      gap: 0.85rem;
      margin-top: 1.5rem;
    }

    .showcase-card {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding: 1.25rem;
      background: var(--bg-elevated);
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      transition: border-color 0.12s ease, transform 0.12s ease;
      min-height: 11rem;
    }

    .showcase-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }

    .showcase-card-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      color: var(--accent);
      border-radius: var(--radius-md);
    }

    .showcase-card-icon svg {
      width: 1.2rem;
      height: 1.2rem;
    }

    .showcase-card h4 {
      margin: 0.25rem 0 0;
      color: var(--ink);
      font-family: var(--mono);
      font-weight: 500;
      font-size: 1.05rem;
      letter-spacing: -0.01em;
    }

    .showcase-card p {
      margin: 0;
      color: var(--ink-soft);
      font-size: 0.88rem;
      line-height: 1.55;
      flex: 1;
    }

    .showcase-card-tag {
      display: inline-block;
      margin-top: auto;
      padding: 0.15rem 0.5rem;
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--muted);
      text-transform: lowercase;
      letter-spacing: 0.04em;
      align-self: flex-start;
    }

    .showcase-card-cta {
      border-style: dashed;
      background: transparent;
    }

    .showcase-card-link {
      color: var(--accent);
      font-family: var(--mono);
      font-size: 0.85rem;
      text-decoration: none;
      margin-top: auto;
    }

    .showcase-card-link:hover {
      text-decoration: underline;
    }

    /* Submit */
    .showcase-submit {
      margin-top: 3.5rem;
    }

    .showcase-submit-card {
      padding: 2rem;
      background: var(--bg-elevated);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
    }

    .showcase-submit-card h3 {
      margin: 0.25rem 0 0;
      color: var(--ink);
      font-family: var(--mono);
      font-weight: 400;
      font-size: 1.4rem;
      letter-spacing: -0.02em;
    }

    .showcase-submit-card p {
      max-width: 620px;
      margin: 0.8rem 0 0;
      color: var(--ink-soft);
      line-height: 1.6;
    }

    .showcase-submit-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.5rem;
    }

    @media (max-width: 38rem) {
      .showcase-f-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</MarketingLayout>
